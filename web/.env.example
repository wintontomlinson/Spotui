# Spotify app Client ID — from https://developer.spotify.com/dashboard
# This is a PUBLIC value. The PKCE flow needs no client secret, so there is
# no secret to configure and nothing sensitive is held by the deployment.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# The redirect URI registered on the Spotify dashboard, exactly.
# Local:  http://127.0.0.1:3000/callback
# Vercel: https://<your-deployment>.vercel.app/callback
NEXT_PUBLIC_REDIRECT_URI=http://127.0.0.1:3000/callback
